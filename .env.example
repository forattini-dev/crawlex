# Crawlex proxy feature test config.
# Copy to .env and fill credentials locally. Never commit .env.

CRAWLEX_PROXY_ENABLED=true
CRAWLEX_PROXY_SCHEME=socks5h
CRAWLEX_PROXY_HOST=proxy.packetstream.io
CRAWLEX_PROXY_PORT=31113
CRAWLEX_PROXY_USER=
CRAWLEX_PROXY_PASSWORD=

# Used by scripts/test_proxy.py
CRAWLEX_PROXY_TEST_URL=https://ipv4.icanhazip.com

# Optional crawler target smoke test.
CRAWLEX_PROXY_TARGET_URL=https://www.drogariasaopaulo.com.br/search?w=paracetamol
